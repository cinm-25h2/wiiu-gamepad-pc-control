+  if (!EnvFlagEnabled("DRC_BIND_MEDIA_SOURCE_PORTS")) {
+    return true;
+  }
+
+  u16 dst_port = ntohs(dst_port_network_order);
+  u16 src_port = 0;
+  if (dst_port == 50120) {
+    src_port = 50020;
+  } else if (dst_port == 50121) {
+    src_port = 50021;
+  } else {
+    return true;
+  }
+
+  int one = 1;
+  setsockopt(sock_fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof (one));
+#ifdef SO_REUSEPORT
+  setsockopt(sock_fd, SOL_SOCKET, SO_REUSEPORT, &one, sizeof (one));
+#endif
+
+  sockaddr_in sin;
+  memset(&sin, 0, sizeof (sin));
+  sin.sin_family = AF_INET;
+  sin.sin_addr.s_addr = inet_addr("192.168.1.10");
+  sin.sin_port = htons(src_port);
+  return bind(sock_fd, reinterpret_cast<sockaddr*>(&sin), sizeof (sin)) != -1;
+}
