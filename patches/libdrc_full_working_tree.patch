+void GetMonotonicTsf(u64* tsf) {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  *tsf = static_cast<u64>(ts.tv_sec) * 1000000ULL +
+         static_cast<u64>(ts.tv_nsec) / 1000ULL;
+}
+
+void GetBoottimeUs(u64* tsf) {
+  struct timespec ts;
+  clock_gettime(CLOCK_BOOTTIME, &ts);
+  *tsf = static_cast<u64>(ts.tv_sec) * 1000000ULL +
+         static_cast<u64>(ts.tv_nsec) / 1000ULL;
+}
