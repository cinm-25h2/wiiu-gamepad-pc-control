+bool GetEnvU64(const char* name, u64* out) {
+  const char* value = getenv(name);
+  if (value == NULL || value[0] == '\0') {
+    return false;
+  }
+
+  char* end = NULL;
+  unsigned long long parsed = strtoull(value, &end, 10);
+  if (end == value || *end != '\0') {
+    return false;
+  }
+
+  *out = static_cast<u64>(parsed);
+  return true;
+}
+
+bool GetEnvS64(const char* name, s64* out) {
+  const char* value = getenv(name);
+  if (value == NULL || value[0] == '\0') {
+    return false;
+  }
+
+  char* end = NULL;
+  long long parsed = strtoll(value, &end, 10);
+  if (end == value || *end != '\0') {
+    return false;
+  }
+
+  *out = static_cast<s64>(parsed);
+  return true;
+}
+
+bool FindIwlmvmTimediffPath(const std::string& drc_if, std::string* out) {
+  glob_t globbuf;
+  memset(&globbuf, 0, sizeof (globbuf));
+
+  std::string pattern = std::string("/sys/kernel/debug/ieee80211/phy*/netdev:")
+      + drc_if + "/iwlmvm/os_device_timediff";
+  int rv = glob(pattern.c_str(), 0, NULL, &globbuf);
+  if (rv == 0 && globbuf.gl_pathc > 0) {
+    *out = globbuf.gl_pathv[0];
+    globfree(&globbuf);
+    return true;
+  }
+
+  globfree(&globbuf);
+  return false;
+}
+
+bool ReadIwlmvmTimediff(const std::string& path, s64* diff) {
+  FILE* fp = fopen(path.c_str(), "r");
+  if (!fp) {
+    return false;
+  }
+
+  char buf[128];
+  bool ok = false;
+  if (fgets(buf, sizeof (buf), fp)) {
+    long long parsed = 0;
+    if (sscanf(buf, "diff=%lld", &parsed) == 1) {
+      *diff = parsed;
+      ok = true;
+    }
+  }
+
+  fclose(fp);
+  return ok;
+}
+
+bool GetIwlmvmDeviceTime(const std::string& drc_if, u64* tsf) {
+  static bool initialized = false;
+  static bool available = false;
+  static bool warned = false;
+  static std::string timediff_path;
+  static s64 os_device_diff = 0;
+  static u64 last_refresh_us = 0;
+
+  if (!initialized) {
+    available = FindIwlmvmTimediffPath(drc_if, &timediff_path);
+    initialized = true;
+  }
+  if (!available) {
+    return false;
+  }
+
+  u64 boottime_us;
+  GetBoottimeUs(&boottime_us);
+  if (last_refresh_us == 0 || boottime_us - last_refresh_us > 1000000ULL) {
+    if (!ReadIwlmvmTimediff(timediff_path, &os_device_diff)) {
+      if (!warned) {
+        fprintf(stderr, "failed to read iwlmvm timediff from %s: %s\n",
+                timediff_path.c_str(), strerror(errno));
+        warned = true;
+      }
+      return false;
+    }
+    last_refresh_us = boottime_us;
+  }
+
+  if (os_device_diff < 0) {
+    *tsf = boottime_us + static_cast<u64>(-os_device_diff);
+  } else if (boottime_us >= static_cast<u64>(os_device_diff)) {
+    *tsf = boottime_us - static_cast<u64>(os_device_diff);
+  } else {
+    return false;
+  }
+  return true;
+}
+
